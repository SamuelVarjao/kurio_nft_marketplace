# Camada de mocks (MSW + Socket.IO simulado). "false" desativa — exige backend real.
VITE_ENABLE_MOCKS=true
# Cenário inicial dos mocks (ver README › Cenários). Padrão: default
VITE_MOCK_SCENARIO=default
# Botão flutuante "Mocks" (painel de demonstração). "false" oculta.
VITE_MOCK_PANEL=true
# Base da API REST (padrão: /api — interceptada pelo MSW)
VITE_API_URL=/api
# Host do Socket.IO (padrão: https://realtime.kurio.test — interceptado pelo MSW)
VITE_SOCKET_URL=https://realtime.kurio.test
